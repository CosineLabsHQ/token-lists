# Protected branches
protected_branches="main"
# Get the branch
current_branch="$(git rev-parse --abbrev-ref HEAD)"

if echo "$protected_branches" | grep -w "$current_branch" > /dev/null; then
  echo "❌ Commit not allowed on '$current_branch' branch!"
  echo "👉 Create a feature/hotfix branch instead."
  exit 1
fi

exit 0