# Protected branches
protected_branches="main"
# Get the branch
current_branch="$(git rev-parse --abbrev-ref HEAD)"

while read local_ref local_sha remote_ref remote_sha
do
  remote_branch=$(echo "$remote_ref" | sed 's/refs\/heads\///')
  if echo "$protected_branches" | grep -w "$remote_branch" > /dev/null; then
    echo "❌ Push to '$remote_branch' branch not allowed!"
    echo "👉 Push your feature/hotfix branch and open a PR instead."
    exit 1
  fi
done

if echo "$protected_branches" | grep -w "$current_branch" > /dev/null; then
  echo "❌ You are on protected branch '$current_branch'!"
  echo "👉 Switch to a feature branch before pushing."
  exit 1
fi

exit 0